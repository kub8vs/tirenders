# Baza: lokalnie SQLite, na produkcji Postgres (zmień provider w prisma/schema.prisma)
DATABASE_URL="file:./dev.db"
APP_URL="https://tirenders.pl"
NEXTAUTH_URL="https://tirenders.pl"
AUTH_SECRET="wygeneruj: openssl rand -base64 32"

# Płatności (Stripe: BLIK, karta, Apple/Google Pay, Przelewy24). Bez kluczy działa bramka testowa.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# E-mail (Resend) i SMS (SMSAPI.pl). Bez kluczy wiadomości trafiają tylko do logu w panelu.
RESEND_API_KEY=""
MAIL_FROM="Tirenders <rezerwacje@tirenders.pl>"
SMSAPI_TOKEN=""
SMS_FROM="TIRENDERS"

# Logowanie Google / Apple (opcjonalne – przyciski pojawią się same)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_ID=""
APPLE_SECRET=""

# Kto dostaje raporty Excel (po przecinku) i powiadomienia o nowych rezerwacjach
REPORT_EMAILS=""
STAFF_NOTIFY_EMAIL=""
GOOGLE_REVIEW_URL=""

# Zabezpieczenie cronów (/api/cron/tick co minutę, /api/cron/daily rano)
CRON_SECRET=""

# Tylko lokalnie: konto właściciela tworzone przez npm run db:seed
SEED_OWNER_EMAIL="owner@tirenders.test"
SEED_OWNER_PASSWORD=""
